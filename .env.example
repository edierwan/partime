# --- Required ---
# PostgreSQL connection string for the partime database
DATABASE_URL=postgresql://user:password@localhost:5432/partime?schema=public

# Secret used to sign admin session JWT cookies. 32+ random bytes recommended.
# Either AUTH_SECRET or NEXTAUTH_SECRET works (AUTH_SECRET takes precedence).
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the deployed app — used to build QR scan links.
NEXT_PUBLIC_APP_URL=https://partime.getouch.co

# Seed admin (created by `npm run prisma:seed` if no admin exists).
SEED_ADMIN_EMAIL=admin@partime.local
SEED_ADMIN_PASSWORD=ChangeMe!2026

# --- Optional ---
# When 'true', seed adds sample staff / event / attendance for local testing.
SEED_SAMPLE_DATA=false
