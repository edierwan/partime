# --- Required ---
# PostgreSQL connection string for the partime database
DATABASE_URL=postgresql://user:password@localhost:5432/partime?schema=public

# Secret used to sign admin session JWT cookies. 32+ random bytes recommended.
# Either AUTH_SECRET or NEXTAUTH_SECRET works (AUTH_SECRET takes precedence).
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the deployed app — used to build QR scan links.
NEXT_PUBLIC_APP_URL=https://partime.getouch.co

# Seed admin (created by `npm run prisma:seed` if no admin exists).
SEED_ADMIN_EMAIL=admin@partime.local
SEED_ADMIN_PASSWORD=ChangeMe!2026

# --- Optional ---
# When 'true', seed adds sample staff / event / attendance for local testing.
SEED_SAMPLE_DATA=false

# S3-compatible storage for staff profile photos.
# If omitted, Partime stores uploads locally under LOCAL_UPLOAD_ROOT and serves them from /api/uploads/*.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
LOCAL_UPLOAD_ROOT=/app/uploads

# WhatsApp OTP delivery for staff self-registration.
# The current GetTouch codebase confirms the direct Baileys session send route
# `/api/sessions/:id/messages` with `X-WAPI-Secret`. There is no confirmed
# tenant-only send endpoint yet, so the path/header stay env-driven here.
BAILEYS_API_BASE_URL=
BAILEYS_TENANT=partime
BAILEYS_API_KEY=
BAILEYS_DEFAULT_COUNTRY=MY
BAILEYS_SEND_PATH=/api/sessions/{tenant}/messages
BAILEYS_AUTH_HEADER=X-WAPI-Secret
